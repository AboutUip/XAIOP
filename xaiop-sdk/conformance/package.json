{
  "name": "xaiop-conformance",
  "private": true,
  "type": "module",
  "description": "Node\u2194Java / Node\u2194Python golden dumps, Python\u2194Go core-wire, fuzz",
  "scripts": {
    "build:node": "npm run build:ts --prefix ../nodejs",
    "dump:node": "node node/dump-goldens.mjs --out out/node.ndjson",
    "dump:java": "node java/run-dump.mjs --out out/java.ndjson",
    "compare": "node compare.mjs out/node.ndjson out/java.ndjson",
    "golden": "npm run build:node && npm run dump:node && npm run dump:java && npm run compare",
    "dump:python": "python core-wire/dump-python.py --out out/python.ndjson",
    "dump:go": "go run -C ../go ./cmd/dump-core-wire --cases ../conformance/core-wire/cases.json --out ../conformance/out/go.ndjson",
    "compare:core": "node core-wire/compare-core.mjs out/python.ndjson out/go.ndjson",
    "core-wire": "npm run dump:python && npm run dump:go && npm run compare:core",
    "fuzz:node": "node fuzz/fuzz-node.mjs --max=200",
    "fuzz:java": "node fuzz/fuzz-java/run-fuzz.mjs --max=200",
    "dump:python-product": "python python/dump-goldens.py --out out/python-product.ndjson",
    "compare:python": "node compare.mjs out/node.ndjson out/python-product.ndjson",
    "golden:python": "npm run build:node && npm run dump:node && npm run dump:python-product && npm run compare:python"
  }
}
