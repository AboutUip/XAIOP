# =============================================================================
# XAIOP — repository .gitignore
# Layout: docs/ (Docsify via views) · views/ (lab) ·
#         xaiop-sdk/{nodejs,java,python,go,timing} · skills/ (source-only, tracked) ·
#         demos/ · resources/ · conformance/
# Intentionally TRACKED (do not ignore): docs/vendor/, skills/, docs/themes/
# Local-only scratch: dev/ (never published)
# =============================================================================

# --- Local / workspace (do not publish) --------------------------------------
# Personal scratch / trash -- local only; never commit.
dev/
.cursor/
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.history/
.fleet/
.zed/
*.sublime-project
*.sublime-workspace

# --- OS ----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*:Zone.Identifier

# --- Secrets / env -----------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
**/secrets/
**/secret/
*.keystore

# --- Logs & scratch ----------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.old
*.rej

# --- Node.js / npm / yarn / pnpm / bun ---------------------------------------
# (xaiop-sdk/nodejs, demos/nodejs, views, site, …)
# Lockfiles (package-lock.json) are tracked — do not add them here.
node_modules/
jspm_packages/
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnpm-store/
.bun/
bower_components/

# Build & pack outputs (Node SDK → dist/xaiop-*.tgz; Vite / TS emit)
dist/
build/
out/
.output/
*.tgz
*.tsbuildinfo
*.js.map
*.d.ts.map

# Test / coverage / caches
coverage/
.nyc_output/
.vitest/
.jest/
test-results/
playwright-report/
blob-report/
cypress/videos/
cypress/screenshots/
.eslintcache
.stylelintcache
.prettiercache
.cache/
.parcel-cache/
.vite/
.turbo/
.nuxt/
.next/
.svelte-kit/
.vercel/
.netlify/
.wrangler/
storybook-static/

# --- Vue / Vite lab (views/) -------------------------------------------------
views/dist/
views/node_modules/
views/.vite/
*.local

# --- Java / Maven / Gradle (xaiop-sdk/java) ----------------------------------
# Pack output: xaiop-sdk/java/target/xaiop-*.jar (local only)
target/
**/target/
.gradle/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
*.dump
*.dumpstream
.mtj.tmp/
.classpath
.project
.settings/
*.iml
*.ipr
*.iws
# Maven release / versions plugin backups
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml
.mvn/timing.properties
# Keep wrapper jar if added later (explicit allow)
!.mvn/wrapper/maven-wrapper.jar

# --- SDK timing harness (xaiop-sdk/timing) -----------------------------------
xaiop-sdk/timing/node_modules/
xaiop-sdk/timing/last-report.json
xaiop-sdk/timing/last-bench.json
xaiop-sdk/timing/baseline-bench.json
xaiop-sdk/timing/last-bench-python.json
xaiop-sdk/timing/baseline-bench-python.json

# --- Python (xaiop-sdk/python) -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.venv/
venv/
ENV/
env/
.python-version
python-version.txt
*.manifest
MANIFEST
# Wheel / sdist build drops
*.whl
# Keep intentional specs under docs; ignore accidental pyinstaller drops at root
/*.spec
# Editable / setuptools local state
src/*.egg-info/
**/src/*.egg-info/

# --- Go (xaiop-sdk/go) -------------------------------------------------------
# Module: github.com/AboutUip/XAIOP/xaiop-sdk/go
bin/
**/bin/
vendor/
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
coverage.out
coverage.html
profile.cov
cpu.prof
mem.prof
*.prof
go.work
go.work.sum
# Accidental local binaries named after the package
/xaiop
/xaiop.exe

# --- Conformance dumps (Node↔Java golden · Python↔Go core-wire) --------------
xaiop-sdk/conformance/out/
xaiop-sdk/conformance/**/out/
*.ndjson

# --- Archives / binary drops (accidental at repo root) -----------------------
/*.zip
/*.7z
/*.rar
/*.tar
/*.tar.gz
/*.tgz
/xaiop-*.tgz
/xaiop-*.jar

# --- Misc tooling ------------------------------------------------------------
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
